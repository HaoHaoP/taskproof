# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.db
*.db-shm
*.db-wal

# Node / frontend
node_modules/
web/dist/
.vite/

# Desktop app icons: tracked on purpose. The `build/` rule above is for Python
# artefacts, but Electron looks for its icon there too (electron-builder's
# zero-config spot), so re-include just these two files. git needs the directory
# itself un-ignored before a file inside it can come back, hence the four lines.
!desktop/build/
desktop/build/*
# In-repo worktrees: the desktop lane used to point at desktop/, so its checkouts
# landed inside the repo as desktop-wt-<task>. The lane's path is the repo root now;
# this keeps any leftover (and anything similar) out of `git status` and the gate.
desktop-wt-*/

# …and these two trees are generated by `npm run runtime:fetch`
# (desktop/scripts/fetch-runtime.mjs): the pinned CPython runtime and its
# download cache. Never committed — keep them separate from the icon assets.
desktop/build/runtime/
desktop/build/cache/
# …but these are SOURCE assets that live there (they ship with the app), not build output:
!desktop/build/icon.icns
!desktop/build/icon.png
!desktop/build/trayTemplate.png
!desktop/build/trayTemplate@2x.png
!desktop/build/icon.icns
!desktop/build/icon.png

# Editors / OS
.DS_Store
._*
.idea/
.vscode/
*.swp

# Local state produced by running taskproof
.taskproof/
*.jsonl
!docs/**/*.jsonl
.verify/

# Agent-facing context files generated by tooling (unreviewed)
AGENTS.md
plan.md

# Secrets / local config (never commit)
.env
.env.*
!env.example
